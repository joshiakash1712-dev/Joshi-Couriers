{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with role and merchant details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "defaultAddress": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer", "admin", "team"] },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "minLength": 10, "maxLength": 40 }
      },
      "required": ["id", "name", "role", "createdAt"]
    },
    "ParcelItem": {
      "title": "ParcelItem",
      "description": "Authenticated delivery shipment booking preserved until admin deletion",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderPhone": { "type": "string", "maxLength": 30 },
        "senderEmail": { "type": "string", "maxLength": 200 },
        "senderBusiness": { "type": "string", "maxLength": 200 },
        "pickupAddress": { "type": "string", "maxLength": 500 },
        "fromLocationId": { "type": "string", "maxLength": 80 },
        "fromCity": { "type": "string", "maxLength": 100 },
        "toLocationId": { "type": "string", "maxLength": 80 },
        "toCity": { "type": "string", "maxLength": 100 },
        "receiverName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "receiverPhone": { "type": "string", "maxLength": 30 },
        "receiverEmail": { "type": "string", "maxLength": 200 },
        "deliveryAddress": { "type": "string", "maxLength": 500 },
        "parcelType": { "type": "string", "maxLength": 150 },
        "weightCategory": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "fare": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["cash_on_delivery", "upi_on_delivery"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "collected"] },
        "status": {
          "type": "string",
          "enum": [
            "pending_approval",
            "ordered",
            "picked",
            "shipped",
            "pickup_scheduled",
            "picked_up",
            "in_transit",
            "arrived_partur",
            "out_for_delivery",
            "delivered"
          ]
        },
        "createdAt": { "type": "string", "minLength": 10, "maxLength": 40 },
        "scheduledDeliveryDate": { "type": "string", "maxLength": 40 },
        "deliverySlot": { "type": "string", "maxLength": 120 },
        "history": { "type": "array", "description": "Append-only shipment milestone log" }
      },
      "required": [
        "id",
        "userId",
        "senderName",
        "senderPhone",
        "pickupAddress",
        "fromLocationId",
        "fromCity",
        "toLocationId",
        "toCity",
        "receiverName",
        "receiverPhone",
        "deliveryAddress",
        "parcelType",
        "weightCategory",
        "fare",
        "paymentMode",
        "paymentStatus",
        "status",
        "createdAt",
        "scheduledDeliveryDate",
        "deliverySlot",
        "history"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profile collection"
    },
    "/parcels/{parcelId}": {
      "schema": "ParcelItem",
      "description": "Parcel delivery bookings collection preserved until deleted by admin"
    }
  }
}
